{
    "name": "GymTrack",
    "short_name": "GymTrack",
    "description": "Log workouts, track body metrics, analyze progression, and smash PRs.",
    "start_url": "/dashboard",
    "scope": "/",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone"],
    "orientation": "portrait",
    "background_color": "#09090b",
    "theme_color": "#09090b",
    "prefer_related_applications": false,
    "icons": [
        {
            "src": "/icon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any maskable"
        }
    ],
    "screenshots": [
        {
            "src": "/screenshot-dashboard.png",
            "sizes": "1170x2532",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "Dashboard with stats and recent workouts"
        }
    ],
    "categories": ["health", "fitness", "lifestyle"]
}
